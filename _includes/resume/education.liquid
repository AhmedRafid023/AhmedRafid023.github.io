<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item cv-card">
      <div class="cv-card-logo">
        {% if content.logo and content.logo != '' %}
          <img src="{{ content.logo | relative_url }}" alt="{{ content.institution }}" loading="lazy" onerror="this.closest('.cv-card-logo').style.display='none'" />
        {% endif %}
      </div>
      <div class="cv-card-body">
        <div class="cv-card-head">
          <div class="cv-card-titles">
            <h6 class="cv-card-title">
              {% if content.url and content.url != '' %}
                <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.studyType }}</a>
              {% else %}
                {{ content.studyType }}
              {% endif %}
            </h6>
            <div class="cv-card-org">
              {{ content.institution }}{% if content.location and content.location != '' %} · {{ content.location }}{% endif %}
            </div>
          </div>
          {% assign sd = content.startDate %}
          {% if sd contains '-' %}{% assign sd = sd | date: '%b %Y' %}{% endif %}
          {% assign ed = content.endDate %}
          {% if ed == blank or ed == '-' or ed == 'Present' %}{% assign ed = 'Present' %}{% elsif ed contains '-' %}{% assign ed = ed | date: '%b %Y' %}{% endif %}
          <div class="cv-card-date">{{ sd }} – {{ ed }}</div>
        </div>

        {% if content.area and content.area != '' %}
          <p class="cv-card-summary cv-card-area">{{ content.area }}</p>
        {% endif %}

        {% if content.score %}
          <p class="cv-card-summary">CGPA: {{ content.score }}</p>
        {% endif %}

        {% if content.courses and content.courses.size > 0 %}
          <ul class="cv-card-highlights">
            {% for item in content.courses %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if content.tags and content.tags.size > 0 %}
          <div class="cv-card-tags">
            {% for tag in content.tags %}
              <span class="cv-tag">{{ tag }}</span>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
