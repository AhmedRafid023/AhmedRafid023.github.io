<div class="cv-grid">
  {% for content in data[1] %}
    <div class="cv-block">
      <div class="cv-block-title">
        {% if content.icon and content.icon != '' %}<i class="{{ content.icon }}"></i>{% endif %}
        {{ content.name }}
      </div>
      <div class="cv-block-sub">{{ content.reference }}</div>
    </div>
  {% endfor %}
</div>
