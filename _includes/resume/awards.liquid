<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item cv-card">
      <div class="cv-card-body">
        <div class="cv-card-head">
          <div class="cv-card-titles">
            <h6 class="cv-card-title">
              {% if content.url and content.url != '' %}
                <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.title }}</a>
              {% else %}
                {{ content.title }}
              {% endif %}
            </h6>
            {% if content.awarder and content.awarder != '' %}
              <div class="cv-card-org">{{ content.awarder }}</div>
            {% endif %}
          </div>
          {% if content.date and content.date != '' %}
            <div class="cv-card-date">{{ content.date }}</div>
          {% endif %}
        </div>

        {% if content.summary and content.summary != '' %}
          <p class="cv-card-summary">{{ content.summary }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
