<div class="cv-interests">
  {% for content in data[1] %}
    <div class="cv-block">
      <div class="cv-block-title">
        {% if content.icon and content.icon != '' %}<i class="{{ content.icon }}"></i>{% endif %}
        {{ content.name }}
      </div>
      {% if content.keywords and content.keywords.size > 0 %}
        <div class="cv-card-tags">
          {% for keyword in content.keywords %}
            <span class="cv-tag">{{ keyword }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>
