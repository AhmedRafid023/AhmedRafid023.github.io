<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <div class="news-feed{% if include.limit and page.announcements.scrollable and news_size > 3 %} news-feed--scrollable{% endif %}">
      {% for item in news limit: news_limit %}
        <div class="news-item">
          <div class="news-date">
            <span class="news-month">{{ item.date | date: '%b' }}</span>
            <span class="news-year">{{ item.date | date: '%Y' }}</span>
          </div>
          <div class="news-dot"></div>
          <div class="news-body">
            {% if item.inline %}
              <p>{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</p>
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-muted">No news so far...</p>
  {% endif %}
</div>
